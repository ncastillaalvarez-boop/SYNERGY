% Synergy - dataset del modelo predictivo de riesgo
% Variables medidas a la mitad del proyecto; nivel_riesgo segun como termino.
@RELATION riesgo_proyectos_synergy

@ATTRIBUTE categoria {'Limpieza de playas','Reforestación','Manglares y ciénagas','Reciclaje y residuos','Huertas comunitarias','Educación ambiental','Fauna y aves','Agua y saneamiento','Energía limpia','Espacios verdes','Calidad del aire','Canales y caños'}
