@ATTRIBUTE pct_tareas_pendientes NUMERIC
@ATTRIBUTE participantes NUMERIC
@ATTRIBUTE tasa_participacion NUMERIC
@ATTRIBUTE duracion_dias NUMERIC
@ATTRIBUTE avance_real NUMERIC
@ATTRIBUTE avance_esperado NUMERIC
@ATTRIBUTE brecha_avance NUMERIC
@ATTRIBUTE actividades NUMERIC
@ATTRIBUTE nivel_riesgo {Bajo,Medio,Alto}

