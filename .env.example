# Copia este archivo como .env (junto a docker-compose.yml) y llena lo que necesites.
# .env está en .gitignore: NO se sube a GitHub. Todo es opcional.

# default = cuentas demo + datos de prueba | prod = base vacía
SPRING_PROFILES_ACTIVE=default

# Usar el MongoDB de tu PC en vez del del contenedor (descomenta):
# MONGODB_URI=mongodb://host.docker.internal:27017/synergy

# Clave de los tokens de la app móvil (mínimo 64 caracteres al azar)
JWT_SECRET=

# Inicio de sesión con Google (el secreto NUEVO, después de rotarlo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Primer administrador con el perfil prod
SYNERGY_ADMIN_CORREO=
SYNERGY_ADMIN_CLAVE=

# true solo si la app está detrás de HTTPS
COOKIE_SOLO_HTTPS=false
